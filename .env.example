# Local frontend/backend example values. Do not commit real secrets.

# ML backend URL (used by Node server to fetch FastAPI/YAMNet ML predictions):
FASTAPI_BACKEND_URL=https://firstoff-animalmind-backend.hf.space
# FASTAPI_BACKEND_URL=http://localhost:8000

# n8n webhook notifications for completed classifications.
# Generate a long random secret and configure the same value in n8n.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
