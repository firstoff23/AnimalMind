# Local frontend/backend example values. Do not commit real secrets.

# ML backend URL (used by Node server to fetch FastAPI/YAMNet ML predictions):
FASTAPI_BACKEND_URL=http://localhost:7860
ML_BACKEND_URL=https://firstoff-animalmind-backend.hf.space
API_KEY=your_optional_api_key

# Optional tRPC base URL for native/Capacitor builds.
# If omitted, Android uses the production API and web builds use /api/trpc.
VITE_TRPC_URL=

# n8n webhook notifications for completed classifications.
# Generate a long random secret and configure the same value in n8n.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Mindi AI chat (Vercel AI Gateway). In Vercel deployments this can also use
# platform OIDC; locally set AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
MINDI_AI_MODEL=
